{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "move (bot to referee)",
  "description": "Answer to turn. Receiving it stops the bot's clock.",
  "type": "object",
  "properties": {
    "type": { "const": "move" },
    "v": { "$ref": "common.schema.json#/$defs/version" },
    "move": { "$ref": "common.schema.json#/$defs/uci" },
    "info": {
      "description": "Optional search information, shown publicly in the viewer (E33). Display only.",
      "type": "object",
      "properties": {
        "depth": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "seldepth": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "score_cp": {
          "description": "Score in centipawns from the bot's point of view.",
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "score_mate": {
          "description": "Mate in this many moves; negative if the bot gets mated.",
          "type": "integer",
          "minimum": -1024,
          "maximum": 1024,
          "not": { "const": 0 }
        },
        "nodes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "pv": {
          "description": "Principal variation, starting with the move played.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/uci" },
          "maxItems": 32
        },
        "text": { "type": "string", "maxLength": 256 }
      },
      "not": { "required": ["score_cp", "score_mate"] },
      "additionalProperties": false
    }
  },
  "required": ["type", "v", "move"],
  "additionalProperties": false
}
