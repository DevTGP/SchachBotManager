{
  "openapi": "3.1.1",
  "info": {
    "title": "SchachBotManager web API",
    "version": "1",
    "description": "Web API of SchachBotManager (backend-api.md, E73): public reading of matches, bots and the game queue; sessions, accounts and administration for invited users (E83, E84, E85). All times are UTC in RFC 3339; durations are milliseconds. Errors carry a code that the frontend translates (E32). Requests other than GET need the header X-SBM-CSRF: 1 (E84).",
    "license": { "name": "MIT-0", "identifier": "MIT-0" }
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "get_health",
        "summary": "Liveness of the API and its database connection.",
        "responses": {
          "200": {
            "description": "The API answers and reaches the database.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Health" } }
            }
          },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/matches": {
      "get": {
        "operationId": "list_matches",
        "summary": "Matches, newest first, without their moves.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Only matches with this status.",
            "schema": { "$ref": "#/components/schemas/MatchStatus" }
          },
          {
            "name": "bot_id",
            "in": "query",
            "description": "Only matches in which this bot plays either colour.",
            "schema": { "$ref": "#/components/schemas/Id" }
          },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Offset" }
        ],
        "responses": {
          "200": {
            "description": "One page of matches.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MatchPage" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/matches/{match_id}": {
      "parameters": [{ "$ref": "#/components/parameters/MatchId" }],
      "get": {
        "operationId": "get_match",
        "summary": "One match with all moves played so far.",
        "responses": {
          "200": {
            "description": "The match.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Match" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/matches/{match_id}/pgn": {
      "parameters": [{ "$ref": "#/components/parameters/MatchId" }],
      "get": {
        "operationId": "get_match_pgn",
        "summary": "The match as PGN, also while it runs (result * until it ends).",
        "responses": {
          "200": {
            "description": "One PGN game.",
            "content": { "application/x-chess-pgn": { "schema": { "type": "string" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/bots": {
      "get": {
        "operationId": "list_bots",
        "summary": "All bots, ordered by name.",
        "responses": {
          "200": {
            "description": "The bots.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/BotList" } }
            }
          }
        }
      }
    },
    "/bots/{bot_id}": {
      "parameters": [
        {
          "name": "bot_id",
          "in": "path",
          "required": true,
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "get": {
        "operationId": "get_bot",
        "summary": "One bot.",
        "responses": {
          "200": {
            "description": "The bot.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Bot" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/queue": {
      "get": {
        "operationId": "get_queue",
        "summary": "Running and waiting matches in queue order with estimated start times (E20).",
        "responses": {
          "200": {
            "description": "The queue.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Queue" } }
            }
          }
        }
      }
    },
    "/session": {
      "get": {
        "operationId": "get_session",
        "summary": "Who is logged in; user is null for guests.",
        "responses": {
          "200": { "$ref": "#/components/responses/Session" }
        }
      },
      "post": {
        "operationId": "login",
        "summary": "Logs in and sets the session cookie.",
        "parameters": [{ "$ref": "#/components/parameters/Csrf" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Session" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/InvalidCredentials" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyAttempts" }
        }
      },
      "delete": {
        "operationId": "logout",
        "summary": "Ends the session and clears the cookie; also fine without a session.",
        "parameters": [{ "$ref": "#/components/parameters/Csrf" }],
        "responses": {
          "204": { "description": "Logged out." },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/invites/redeem": {
      "post": {
        "operationId": "redeem_invite",
        "summary": "Creates an account from an invite and logs it in (E4, E83).",
        "parameters": [{ "$ref": "#/components/parameters/Csrf" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RedeemInvite" } }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Session" },
          "400": { "$ref": "#/components/responses/BadToken" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/UsernameTaken" },
          "429": { "$ref": "#/components/responses/TooManyAttempts" }
        }
      }
    },
    "/password-resets/redeem": {
      "post": {
        "operationId": "redeem_password_reset",
        "summary": "Sets a new password with a reset link from an admin, ends all other sessions of the account and logs it in.",
        "parameters": [{ "$ref": "#/components/parameters/Csrf" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RedeemPasswordReset" } }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Session" },
          "400": { "$ref": "#/components/responses/BadToken" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyAttempts" }
        }
      }
    },
    "/account/password": {
      "put": {
        "operationId": "change_password",
        "security": [{ "session": [] }],
        "summary": "Changes the own password and ends all other sessions of the account.",
        "parameters": [{ "$ref": "#/components/parameters/Csrf" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ChangePassword" } }
          }
        },
        "responses": {
          "204": { "description": "The password is changed." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/InvalidCredentials" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyAttempts" }
        }
      }
    },
    "/admin/users": {
      "get": {
        "operationId": "list_users",
        "security": [{ "session": [] }],
        "summary": "All accounts, ordered by name (admin).",
        "responses": {
          "200": {
            "description": "The accounts.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UserList" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/admin/users/{user_id}": {
      "parameters": [{ "$ref": "#/components/parameters/UserId" }],
      "patch": {
        "operationId": "update_user",
        "security": [{ "session": [] }],
        "summary": "Changes role or active state of another account (admin); deactivation ends its sessions.",
        "parameters": [{ "$ref": "#/components/parameters/Csrf" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UserUpdate" } }
          }
        },
        "responses": {
          "200": {
            "description": "The changed account.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/admin/users/{user_id}/password-reset": {
      "parameters": [{ "$ref": "#/components/parameters/UserId" }],
      "post": {
        "operationId": "create_password_reset",
        "security": [{ "session": [] }],
        "summary": "A one-time link that sets a new password, valid for 24 hours (admin, E83). An earlier unused link of the account stops working.",
        "parameters": [{ "$ref": "#/components/parameters/Csrf" }],
        "responses": {
          "201": {
            "description": "The link; it is shown only this once.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/OneTimeLink" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/admin/invites": {
      "get": {
        "operationId": "list_invites",
        "security": [{ "session": [] }],
        "summary": "Unused invites that have not expired, newest first (admin).",
        "responses": {
          "200": {
            "description": "The open invites.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/InviteList" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "create_invite",
        "security": [{ "session": [] }],
        "summary": "A new one-time invite (admin, E4).",
        "parameters": [{ "$ref": "#/components/parameters/Csrf" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/InviteRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "The invite with its link; the link is shown only this once.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CreatedInvite" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/admin/invites/{invite_id}": {
      "parameters": [
        {
          "name": "invite_id",
          "in": "path",
          "required": true,
          "schema": { "$ref": "#/components/schemas/Id" }
        }
      ],
      "delete": {
        "operationId": "revoke_invite",
        "security": [{ "session": [] }],
        "summary": "Withdraws an open invite (admin).",
        "parameters": [{ "$ref": "#/components/parameters/Csrf" }],
        "responses": {
          "204": { "description": "The invite no longer works." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/admin/matches": {
      "post": {
        "operationId": "enqueue_matches",
        "security": [{ "session": [] }],
        "summary": "Puts single games between two verified bots into the queue (admin, E71, E85).",
        "parameters": [{ "$ref": "#/components/parameters/Csrf" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/EnqueueRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "The new matches in the order they were queued.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/EnqueuedMatches" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/admin/queue": {
      "patch": {
        "operationId": "update_queue",
        "security": [{ "session": [] }],
        "summary": "Pauses or resumes the queue (admin); a running match plays to its end.",
        "parameters": [{ "$ref": "#/components/parameters/Csrf" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/QueueUpdate" } }
          }
        },
        "responses": {
          "200": {
            "description": "The queue settings now in force.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/QueueUpdate" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "description": "The session from POST /session, /invites/redeem or /password-resets/redeem: an HttpOnly cookie for /api/, SameSite=Strict, Secure behind HTTPS; valid until 14 days after its last use (E84).",
        "type": "apiKey",
        "in": "cookie",
        "name": "sbm_session"
      }
    },
    "parameters": {
      "Csrf": {
        "name": "X-SBM-CSRF",
        "in": "header",
        "required": true,
        "description": "Protection against cross-site requests: browsers send this header from other sites only after a CORS preflight, which the API never allows (E84). Without it the API answers 403 with code csrf_failed.",
        "schema": { "const": "1" }
      },
      "UserId": {
        "name": "user_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Id" }
      },
      "MatchId": {
        "name": "match_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Id" }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Page size.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "description": "Number of items to skip.",
        "schema": { "type": "integer", "minimum": 0, "maximum": 1000000, "default": 0 }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "A parameter is invalid (code invalid_parameter).",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "NotFound": {
        "description": "No such resource (code not_found).",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Unavailable": {
        "description": "The database is unreachable (code unavailable).",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Unauthenticated": {
        "description": "No valid session (code unauthenticated).",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Forbidden": {
        "description": "The X-SBM-CSRF header is missing (code csrf_failed) or the account may not do this (code forbidden).",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "InvalidCredentials": {
        "description": "Unknown name, wrong password or deactivated account (code invalid_credentials); for routes that need a session also unauthenticated.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "TooManyAttempts": {
        "description": "Too many attempts from this address or for this account; try again later (code too_many_attempts, E84).",
        "headers": {
          "Retry-After": {
            "description": "Seconds until the next attempt may succeed.",
            "schema": { "type": "integer", "minimum": 1 }
          }
        },
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "BadToken": {
        "description": "A field is invalid (code invalid_parameter) or the link is unknown, used or expired (code invalid_token).",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "UsernameTaken": {
        "description": "The name is in use, also in another case (code username_taken).",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Session": {
        "description": "The session after the request.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/SessionState" } }
        }
      }
    },
    "schemas": {
      "Id": {
        "description": "Identifier of a document: 24 lowercase hexadecimal digits.",
        "type": "string",
        "pattern": "^[0-9a-f]{24}(?!\\n)$"
      },
      "Timestamp": { "type": "string", "format": "date-time" },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "invalid_parameter",
              "not_found",
              "unavailable",
              "internal",
              "unauthenticated",
              "forbidden",
              "csrf_failed",
              "invalid_credentials",
              "invalid_token",
              "username_taken",
              "too_many_attempts"
            ]
          },
          "message": { "description": "English text for logs; not shown to users.", "type": "string" },
          "field": { "description": "The invalid parameter, for invalid_parameter.", "type": "string" }
        },
        "required": ["code", "message"],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": { "status": { "const": "ok" } },
        "required": ["status"],
        "additionalProperties": false
      },
      "MatchStatus": {
        "description": "aborted: discarded after infrastructure errors and not played again (match-runner.md).",
        "enum": ["queued", "running", "finished", "aborted"]
      },
      "Result": { "$ref": "../protocol/v1/game_over.schema.json#/properties/result" },
      "Termination": { "$ref": "../protocol/v1/game_over.schema.json#/properties/termination" },
      "Discipline": {
        "description": "The conditions the match was played under, copied when it was created.",
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "initial_time_ms": { "type": "integer", "minimum": 1 },
          "increment_ms": { "type": "integer", "minimum": 0 },
          "startup_ms": { "type": "integer", "minimum": 1 },
          "tolerance_ms": { "type": "integer", "minimum": 0 },
          "max_moves": { "type": "integer", "minimum": 1 }
        },
        "required": [
          "name",
          "initial_time_ms",
          "increment_ms",
          "startup_ms",
          "tolerance_ms",
          "max_moves"
        ],
        "additionalProperties": false
      },
      "Side": {
        "description": "One side of a match. sdk and lang are filled once the bot reported ready.",
        "type": "object",
        "properties": {
          "kind": { "const": "bot" },
          "bot_id": { "$ref": "#/components/schemas/Id" },
          "name": { "type": "string" },
          "sdk": { "type": ["string", "null"] },
          "lang": { "type": ["string", "null"] }
        },
        "required": ["kind", "bot_id", "name", "sdk", "lang"],
        "additionalProperties": false
      },
      "MatchFields": {
        "description": "The fields of MatchSummary, open for extension by Match.",
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "type": { "const": "single" },
          "status": { "$ref": "#/components/schemas/MatchStatus" },
          "white": { "$ref": "#/components/schemas/Side" },
          "black": { "$ref": "#/components/schemas/Side" },
          "discipline": { "$ref": "#/components/schemas/Discipline" },
          "result": {
            "description": "null until the match ends.",
            "oneOf": [{ "$ref": "#/components/schemas/Result" }, { "type": "null" }]
          },
          "termination": {
            "description": "null until the match ends.",
            "oneOf": [{ "$ref": "#/components/schemas/Termination" }, { "type": "null" }]
          },
          "ply_count": { "type": "integer", "minimum": 0 },
          "created_at": { "$ref": "#/components/schemas/Timestamp" },
          "started_at": {
            "oneOf": [{ "$ref": "#/components/schemas/Timestamp" }, { "type": "null" }]
          },
          "finished_at": {
            "oneOf": [{ "$ref": "#/components/schemas/Timestamp" }, { "type": "null" }]
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "white",
          "black",
          "discipline",
          "result",
          "termination",
          "ply_count",
          "created_at",
          "started_at",
          "finished_at"
        ]
      },
      "MatchSummary": {
        "allOf": [{ "$ref": "#/components/schemas/MatchFields" }],
        "unevaluatedProperties": false
      },
      "Move": {
        "type": "object",
        "properties": {
          "ply": { "description": "1 for White's first move.", "type": "integer", "minimum": 1 },
          "uci": { "type": "string" },
          "san": { "type": "string" },
          "fen": { "description": "Position after the move.", "type": "string" },
          "spent_ms": { "description": "Thinking time of this move.", "type": "integer", "minimum": 0 },
          "clock_ms": {
            "description": "The mover's remaining time after the move, increment included.",
            "type": "integer",
            "minimum": 0
          },
          "info": {
            "description": "Search information the bot reported, public (E33).",
            "oneOf": [
              { "$ref": "../protocol/v1/move.schema.json#/properties/info" },
              { "type": "null" }
            ]
          }
        },
        "required": ["ply", "uci", "san", "fen", "spent_ms", "clock_ms", "info"],
        "additionalProperties": false
      },
      "Match": {
        "allOf": [{ "$ref": "#/components/schemas/MatchFields" }],
        "type": "object",
        "properties": {
          "start_fen": { "type": "string" },
          "moves": { "type": "array", "items": { "$ref": "#/components/schemas/Move" } }
        },
        "required": ["start_fen", "moves"],
        "unevaluatedProperties": false
      },
      "MatchPage": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/MatchSummary" } },
          "total": { "description": "Matches matching the filter.", "type": "integer", "minimum": 0 }
        },
        "required": ["items", "total"],
        "additionalProperties": false
      },
      "Bot": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "name": { "type": "string" },
          "language": { "enum": ["python", "cpp", "java", "csharp", "javascript"] },
          "status": { "const": "verified" },
          "builtin": {
            "description": "A reference bot shipped with the SDK (E68, E72).",
            "type": "boolean"
          },
          "created_at": { "$ref": "#/components/schemas/Timestamp" }
        },
        "required": ["id", "name", "language", "status", "builtin", "created_at"],
        "additionalProperties": false
      },
      "BotList": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Bot" } }
        },
        "required": ["items"],
        "additionalProperties": false
      },
      "QueueEntry": {
        "type": "object",
        "properties": {
          "match": { "$ref": "#/components/schemas/MatchSummary" },
          "position": {
            "description": "1 for the next match to start; 0 for running matches.",
            "type": "integer",
            "minimum": 0
          },
          "estimated_start": {
            "description": "When the match should start; for running matches when it started.",
            "$ref": "#/components/schemas/Timestamp"
          },
          "estimated_end": { "$ref": "#/components/schemas/Timestamp" }
        },
        "required": ["match", "position", "estimated_start", "estimated_end"],
        "additionalProperties": false
      },
      "Queue": {
        "type": "object",
        "properties": {
          "paused": {
            "description": "No new matches start while the queue is paused.",
            "type": "boolean"
          },
          "running": { "type": "array", "items": { "$ref": "#/components/schemas/QueueEntry" } },
          "waiting": {
            "description": "In start order; at most 200 entries.",
            "type": "array",
            "items": { "$ref": "#/components/schemas/QueueEntry" },
            "maxItems": 200
          },
          "waiting_total": { "type": "integer", "minimum": 0 }
        },
        "required": ["paused", "running", "waiting", "waiting_total"],
        "additionalProperties": false
      },
      "Username": {
        "description": "3 to 32 letters, digits, _ . or -, starting with a letter or digit; unique regardless of case (E83).",
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,31}(?!\\n)$"
      },
      "Password": {
        "description": "10 to 128 characters (E84).",
        "type": "string",
        "minLength": 10,
        "maxLength": 128
      },
      "OneTimeToken": {
        "description": "The secret part of an invite or reset link, after the # (E83).",
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{43}(?!\\n)$"
      },
      "Role": {
        "description": "coder: own bots; admin: everything (backend-api.md).",
        "enum": ["coder", "admin"]
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "username": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" }
        },
        "required": ["id", "username", "role"],
        "additionalProperties": false
      },
      "SessionState": {
        "type": "object",
        "properties": {
          "user": {
            "description": "null for guests.",
            "oneOf": [{ "$ref": "#/components/schemas/CurrentUser" }, { "type": "null" }]
          }
        },
        "required": ["user"],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "minLength": 1, "maxLength": 32 },
          "password": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "required": ["username", "password"],
        "additionalProperties": false
      },
      "RedeemInvite": {
        "type": "object",
        "properties": {
          "token": { "$ref": "#/components/schemas/OneTimeToken" },
          "username": { "$ref": "#/components/schemas/Username" },
          "password": { "$ref": "#/components/schemas/Password" }
        },
        "required": ["token", "username", "password"],
        "additionalProperties": false
      },
      "RedeemPasswordReset": {
        "type": "object",
        "properties": {
          "token": { "$ref": "#/components/schemas/OneTimeToken" },
          "password": { "$ref": "#/components/schemas/Password" }
        },
        "required": ["token", "password"],
        "additionalProperties": false
      },
      "ChangePassword": {
        "type": "object",
        "properties": {
          "current_password": { "type": "string", "minLength": 1, "maxLength": 128 },
          "new_password": { "$ref": "#/components/schemas/Password" }
        },
        "required": ["current_password", "new_password"],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "username": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" },
          "active": {
            "description": "A deactivated account cannot log in.",
            "type": "boolean"
          },
          "created_at": { "$ref": "#/components/schemas/Timestamp" },
          "last_login_at": {
            "oneOf": [{ "$ref": "#/components/schemas/Timestamp" }, { "type": "null" }]
          }
        },
        "required": ["id", "username", "role", "active", "created_at", "last_login_at"],
        "additionalProperties": false
      },
      "UserList": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
        },
        "required": ["items"],
        "additionalProperties": false
      },
      "UserUpdate": {
        "description": "At least one field; admins cannot change their own account this way.",
        "type": "object",
        "properties": {
          "role": { "$ref": "#/components/schemas/Role" },
          "active": { "type": "boolean" }
        },
        "minProperties": 1,
        "additionalProperties": false
      },
      "OneTimeLink": {
        "type": "object",
        "properties": {
          "url": {
            "description": "The page of the SPA with the token after the #, so it stays out of server logs.",
            "type": "string"
          },
          "expires_at": { "$ref": "#/components/schemas/Timestamp" }
        },
        "required": ["url", "expires_at"],
        "additionalProperties": false
      },
      "Invite": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Id" },
          "role": { "$ref": "#/components/schemas/Role" },
          "created_by": {
            "description": "Name of the admin; null for invites from the command line.",
            "type": ["string", "null"]
          },
          "created_at": { "$ref": "#/components/schemas/Timestamp" },
          "expires_at": { "$ref": "#/components/schemas/Timestamp" }
        },
        "required": ["id", "role", "created_by", "created_at", "expires_at"],
        "additionalProperties": false
      },
      "InviteList": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Invite" } }
        },
        "required": ["items"],
        "additionalProperties": false
      },
      "InviteRequest": {
        "type": "object",
        "properties": {
          "role": { "$ref": "#/components/schemas/Role" },
          "valid_days": {
            "description": "How long the invite can be used.",
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 7
          }
        },
        "required": ["role"],
        "additionalProperties": false
      },
      "CreatedInvite": {
        "type": "object",
        "properties": {
          "invite": { "$ref": "#/components/schemas/Invite" },
          "url": {
            "description": "The page of the SPA with the token after the #, so it stays out of server logs.",
            "type": "string"
          }
        },
        "required": ["invite", "url"],
        "additionalProperties": false
      },
      "EnqueueRequest": {
        "description": "The discipline is named after the time control in seconds, e.g. 180+2 or 20+0.5; bots get 10 s to start (E85).",
        "type": "object",
        "properties": {
          "white_bot_id": { "$ref": "#/components/schemas/Id" },
          "black_bot_id": { "$ref": "#/components/schemas/Id" },
          "initial_time_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
          "increment_ms": { "type": "integer", "minimum": 0, "maximum": 3600000, "default": 0 },
          "games": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 },
          "alternate": {
            "description": "Swap colours after every game.",
            "type": "boolean",
            "default": false
          },
          "priority": {
            "description": "Higher starts first; equal priorities in the order queued.",
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "default": 100
          },
          "max_moves": {
            "description": "Full moves until the game is drawn.",
            "type": "integer",
            "minimum": 1,
            "maximum": 2000,
            "default": 500
          },
          "start_fen": {
            "description": "Start position; null or missing for the standard position.",
            "type": ["string", "null"],
            "maxLength": 100
          }
        },
        "required": ["white_bot_id", "black_bot_id", "initial_time_ms"],
        "additionalProperties": false
      },
      "EnqueuedMatches": {
        "type": "object",
        "properties": {
          "match_ids": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Id" },
            "minItems": 1
          }
        },
        "required": ["match_ids"],
        "additionalProperties": false
      },
      "QueueUpdate": {
        "type": "object",
        "properties": {
          "paused": { "type": "boolean" }
        },
        "required": ["paused"],
        "additionalProperties": false
      }
    }
  }
}
