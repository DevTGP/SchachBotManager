{
  "name": "schachbotmanager",
  "version": "0.4.0",
  "description": "SDK for chess bots of the SchachBotManager: board, moves, clock, log and the game protocol",
  "license": "MIT-0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prebuilds"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/*.test.ts\"",
    "lint": "eslint . && node scripts/lint-template.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write . ../../templates/javascript",
    "format:check": "prettier --check . ../../templates/javascript"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "node-addon-api": "^8.9.2",
    "node-api-headers": "^1.9.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
