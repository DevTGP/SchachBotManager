{
  "ruleset": "javascript-1",
  "modules": ["schachbotmanager"],
  "forbidden_globals": [
    "__dirname",
    "__filename",
    "arguments",
    "Atomics",
    "eval",
    "EventSource",
    "exports",
    "fetch",
    "Function",
    "global",
    "globalThis",
    "module",
    "process",
    "Proxy",
    "Reflect",
    "require",
    "SharedArrayBuffer",
    "WebAssembly",
    "WebSocket",
    "Worker"
  ],
  "forbidden_properties": [
    "__defineGetter__",
    "__defineSetter__",
    "__lookupGetter__",
    "__lookupSetter__",
    "__proto__",
    "callee",
    "caller",
    "constructor",
    "defineProperties",
    "defineProperty",
    "getOwnPropertyDescriptor",
    "getOwnPropertyDescriptors",
    "getPrototypeOf",
    "prepareStackTrace",
    "prototype",
    "setPrototypeOf"
  ],
  "import_meta": ["main"],
  "max_findings": 100
}
