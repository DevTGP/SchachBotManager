{
  "ruleset": "python-1",
  "modules": [
    "__future__",
    "array",
    "bisect",
    "collections",
    "collections.abc",
    "copy",
    "dataclasses",
    "enum",
    "functools",
    "heapq",
    "itertools",
    "math",
    "operator",
    "random",
    "sbm",
    "time",
    "typing"
  ],
  "reserved_modules": ["sitecustomize", "usercustomize"],
  "forbidden_builtins": [
    "__import__",
    "breakpoint",
    "compile",
    "delattr",
    "eval",
    "exec",
    "exit",
    "getattr",
    "globals",
    "help",
    "input",
    "locals",
    "open",
    "quit",
    "setattr",
    "vars"
  ],
  "forbidden_attributes": [
    "ag_await",
    "ag_code",
    "ag_frame",
    "attrgetter",
    "cr_await",
    "cr_code",
    "cr_frame",
    "evaluate",
    "evaluate_forward_ref",
    "f_back",
    "f_builtins",
    "f_code",
    "f_globals",
    "f_locals",
    "ForwardRef",
    "get_type_hints",
    "gi_code",
    "gi_frame",
    "gi_yieldfrom",
    "methodcaller",
    "tb_frame",
    "tb_next"
  ],
  "dunder_loads": ["__name__"],
  "dunder_stores": ["__all__", "__slots__"],
  "dunder_attributes": ["__init__"],
  "dunder_strings": ["__main__"],
  "private_bases": ["cls", "self"],
  "max_findings": 100
}
