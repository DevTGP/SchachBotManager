<Project>
  <!-- Shared settings of the C# SDK and its tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Build directory of the shared core (sdk/core built with SBM_SHARED=ON). -->
    <SbmNativeDir Condition="'$(SbmNativeDir)' == ''"
      >$(MSBuildThisFileDirectory)../../build/core</SbmNativeDir>
    <!-- One version for the core and every SDK (E36): read from sdk/core/CMakeLists.txt. -->
    <SbmCoreVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../core/CMakeLists.txt')), 'project\(sbm_core VERSION ([0-9.]+)').Groups[1].Value)</SbmCoreVersion>
  </PropertyGroup>
</Project>
