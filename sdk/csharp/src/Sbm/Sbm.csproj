<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Not "Sbm": on Windows Sbm.dll and the core's sbm.dll would be the same file. -->
    <AssemblyName>SchachBotManager</AssemblyName>
    <RootNamespace>Sbm</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- The NuGet package (E199). -->
  <PropertyGroup>
    <PackageId>SchachBotManager</PackageId>
    <Version>$(SbmCoreVersion)</Version>
    <Authors>DevTGP</Authors>
    <Description>SDK for chess bots on SchachBotManager.</Description>
    <PackageLicenseExpression>MIT-0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DevTGP/SchachBotManager</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DevTGP/SchachBotManager</RepositoryUrl>
    <PackageTags>chess;chess-bot;schachbotmanager</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- The shared core next to the assembly, where the default native library search finds it.
       Wildcards, so that only the library of the current platform is copied. Without
       SbmRuntimesDir the package carries this library, for local tests; the full package path
       drops the folder bin/Release of multi-config builds. -->
  <ItemGroup>
    <None
      Include="$(SbmNativeDir)/lib/libsbm*.so;$(SbmNativeDir)/lib/libsbm*.dylib;$(SbmNativeDir)/bin/**/sbm.dll"
      CopyToOutputDirectory="PreserveNewest"
      Link="%(Filename)%(Extension)"
      Visible="false"
    >
      <Pack Condition="'$(SbmRuntimesDir)' == ''">true</Pack>
      <PackagePath>runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/%(Filename)%(Extension)</PackagePath>
    </None>
  </ItemGroup>

  <!-- The package for every platform: SbmRuntimesDir holds <rid>/native/<library> (nuget.yml). -->
  <ItemGroup Condition="'$(SbmRuntimesDir)' != ''">
    <None Include="$(SbmRuntimesDir)/**/*" Pack="true" PackagePath="runtimes/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- The analyzer of uploaded bots (E203) in the package, so that the IDE and the build report
       what the server would reject. Built first, but not referenced by the SDK itself. -->
  <ItemGroup>
    <ProjectReference
      Include="../Sbm.Analyzers/Sbm.Analyzers.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
    <None
      Include="../Sbm.Analyzers/bin/$(Configuration)/netstandard2.0/SchachBotManager.Analyzers.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sbm.Tests" />
  </ItemGroup>
</Project>
