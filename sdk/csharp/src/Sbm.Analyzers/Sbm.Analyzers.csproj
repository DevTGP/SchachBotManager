<Project Sdk="Microsoft.NET.Sdk">
  <!-- The analyzer of uploaded bots (E203): in the NuGet package for the IDE and the build, and
       in the server's build tool. netstandard2.0, as every compiler host requires. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SchachBotManager.Analyzers</AssemblyName>
    <RootNamespace>Sbm.Analyzers</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Roslyn of the .NET 10.0.1xx SDK; a newer SDK loads it as well. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    <PackageReference
      Include="Microsoft.CodeAnalysis.Analyzers"
      Version="4.14.0"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="csharp_rules.txt" LogicalName="Sbm.Analyzers.csharp_rules.txt" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sbm.Analyzers.Tests" />
  </ItemGroup>
</Project>
