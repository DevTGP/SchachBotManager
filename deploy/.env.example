# Values for deploy/compose.yaml. On the server the deploy workflow writes deploy/.env from the
# GitHub secrets (E78); copy this file to deploy/.env only for a stack on your own machine.
# Passwords: letters and digits only, at least 16 characters, because they become part of
# connection URIs. Generate one with: openssl rand -hex 24

# Public address of the site, written into the Site tag of the PGN exports.
SBM_PUBLIC_URL=https://schachbotmanager.example.org

# Database name of the application.
SBM_MONGO_DB=sbm

# Root user of MongoDB, only used to create the users below. MongoDB takes it over only when the
# volume is created; changing it later needs a manual step (docs/komponenten/deployment.md).
MONGO_ROOT_PASSWORD=change-me

# One user per service: api reads, runner writes, migrate also manages indexes.
MONGO_API_PASSWORD=change-me
MONGO_RUNNER_PASSWORD=change-me
MONGO_MIGRATE_PASSWORD=change-me

# Optional: number of gunicorn workers of the api (default 2).
# API_WORKERS=2
