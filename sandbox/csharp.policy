// Seccomp policy of a C# bot and of the C# build tool in kafel syntax (sandbox.md, E86).
//
// A whitelist of what the .NET runtime, its JIT, GC and threads need, taken from traced games;
// every other system call fails with EPERM. No new processes: clone may only start a thread,
// clone3 reports ENOSYS, so glibc falls back to clone. No sockets except a local pair.

#define CLONE_THREAD 0x00010000
#define AF_UNIX 1
#define O_ACCMODE 3
#define O_RDONLY 0
#define PR_SET_NAME 15
#define PR_GET_NAME 16
#define TCGETS 0x5401
#define TIOCGWINSZ 0x5413
#define FIONREAD 0x541b
#define FIONBIO 0x5421
#define FIONCLEX 0x5450
#define FIOCLEX 0x5451
#define MEMBARRIER_CMD_QUERY 0
#define MEMBARRIER_CMD_PRIVATE_EXPEDITED 8
#define MEMBARRIER_CMD_REGISTER_PRIVATE_EXPEDITED 16

POLICY bot {
  ALLOW {
    // Files and descriptors. Nothing in the jail is writable, and files open only for reading,
    // also /dev/urandom, which a read-only mount would not protect (csharp.cfg).
    read, write, readv, writev, pread64, preadv, lseek, close, close_range,
    open(path, flags) { (flags & O_ACCMODE) == O_RDONLY },
    openat(dirfd, path, flags) { (flags & O_ACCMODE) == O_RDONLY },
    newfstatat, newfstat, newstat, newlstat, statx, access, faccessat, faccessat2,
    readlink, readlinkat, getdents64, getcwd, chdir, fchdir, fcntl, dup, dup2, dup3,
    ioctl(fd, request) {
      request == TCGETS || request == TIOCGWINSZ || request == FIONREAD
        || request == FIONBIO || request == FIONCLEX || request == FIOCLEX
    },

    // Memory
    brk, mmap, munmap, mprotect, mremap, madvise,

    // Threads, signals and synchronisation
    clone(flags) { (flags & CLONE_THREAD) == CLONE_THREAD },
    futex, set_robust_list, get_robust_list, rseq, set_tid_address, arch_prctl,
    sched_yield, sched_getaffinity, sched_getparam, sched_getscheduler,
    rt_sigaction, rt_sigprocmask, rt_sigreturn, rt_sigtimedwait, sigaltstack, kill, tgkill,
    prctl(option) { option == PR_SET_NAME || option == PR_GET_NAME },
    // The runtime flushes the write buffers of its threads with a private membarrier and pins
    // itself to the CPUs it already has; without either it does not start.
    membarrier(cmd) {
      cmd == MEMBARRIER_CMD_QUERY || cmd == MEMBARRIER_CMD_PRIVATE_EXPEDITED
        || cmd == MEMBARRIER_CMD_REGISTER_PRIVATE_EXPEDITED
    },
    sched_setaffinity(pid) { pid == 0 },

    // Identity, time and randomness
    getpid, gettid, getppid, getuid, geteuid, getgid, getegid, getgroups,
    getresuid, getresgid, getpgrp, getpgid, getsid,
    clock_gettime, clock_getres, clock_nanosleep, nanosleep, gettimeofday, time,
    alarm, setitimer, getitimer, getrandom,

    // Waiting on descriptors inside the process
    poll, ppoll, select, pselect6, epoll_create1, epoll_ctl, epoll_wait, epoll_pwait,
    pipe, pipe2, eventfd2,
    socketpair(domain) { domain == AF_UNIX },

    // The process itself
    execve, exit, exit_group, prlimit64, getrlimit, getrusage, times, newuname, sysinfo, umask
  },
  // ENOSYS
  ERRNO(38) {
    clone3
  }
}

// EPERM
USE bot DEFAULT ERRNO(1)
